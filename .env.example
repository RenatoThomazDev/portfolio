# Copie para .env.local (ou configure na hospedagem) e preencha antes de publicar.

# Endereço público do site, sem barra no fim (ex.: https://seudominio.com.br).
# É usado em metadataBase: og:image, canonical, sitemap.xml, robots.txt, JSON-LD e nas tags das demonstrações.
# Entra no build: depois de mudar, faça um novo deploy. Sem ela, na Vercel vale o endereço de produção do projeto
# (https://<projeto>.vercel.app ou o domínio principal); fora da Vercel, http://localhost:3010 (só para testes locais).
NEXT_PUBLIC_SITE_URL=

# Chave da API do Resend (resend.com), usada pela rota app/api/contato para enviar o formulário por e-mail.
# Sem ela, a rota responde erro e o formulário sugere o WhatsApp.
RESEND_API_KEY=

# Opcional: remetente de um domínio verificado no Resend (ex.: Portfólio <contato@seudominio.com.br>).
# Vazio = remetente de teste do Resend, que só entrega para o e-mail dono da conta.
RESEND_FROM=

# Opcional: Redis da Upstash (integração da Vercel) para o limite de envios valer entre todas as instâncias.
# A integração também pode criar KV_REST_API_URL e KV_REST_API_TOKEN, que a rota aceita. Sem elas, vale só o
# limite em memória (por instância).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
